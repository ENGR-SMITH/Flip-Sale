[TEMPLATE]
# Set the real values in Replit Secrets or a local .env (which is git-ignored); never commit populated .env files.

# Database — required to boot the API server
DATABASE_URL=

# Apify scraper platform — required for automatic source collection
APIFY_API_TOKEN=

# Clerk auth — required for sign-in (all three from the same Clerk app)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional
LOG_LEVEL=info
# VITE_CLERK_PROXY_URL=
